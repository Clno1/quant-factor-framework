[Unit]
Description=Quant isolated minute source witness (%i), no signals or delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
EnvironmentFile=/etc/quant/intraday-momentum-monitor.env
ExecStartPre=/home/projects/quant/.venv/bin/python /home/projects/quant/reviews/2026-09-13-cup-resilience/live_witness.py check --root /home/projects/quant --plan /home/projects/quant/outputs/deployments/cup-live-witness-20260914/plan.json --output /home/projects/quant/outputs/data_audits/cup_minute_live/2026-09-14
ExecStart=/home/projects/quant/.venv/bin/python /home/projects/quant/reviews/2026-09-13-cup-resilience/live_witness.py %i --root /home/projects/quant --plan /home/projects/quant/outputs/deployments/cup-live-witness-20260914/plan.json --output /home/projects/quant/outputs/data_audits/cup_minute_live/2026-09-14
Restart=no
RuntimeMaxSec=8h
TimeoutStopSec=15s
CPUQuota=20%
Nice=15
IOSchedulingClass=idle
MemoryHigh=192M
MemoryMax=256M
TasksMax=8
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/outputs/data_audits/cup_minute_live/2026-09-14
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
