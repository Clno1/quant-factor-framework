# Install as /etc/quant/web.env with mode 0600 and owner root:root.
# Do not place Discord webhooks in this long-running Web process.
FMP_API_KEY=replace_with_your_fmp_key

# Required when quant-web binds to 0.0.0.0. Use a randomly generated password
# of at least 16 characters. Basic Auth must still be transported over HTTPS,
# a private VPN, or an SSH tunnel.
QUANT_WEB_AUTH_USER=quant
QUANT_WEB_AUTH_PASSWORD=replace-with-at-least-16-random-characters
# Optional explicit compatibility override. Values below 8 are rejected.
# QUANT_WEB_AUTH_MIN_PASSWORD_LENGTH=8

# Optional group-analytics page. Keep both false until the Web .venv has all
# requirements and the EOD artifacts have been published successfully. When
# migrating an existing enabled page, preserve its existing true values.
GROUP_ANALYTICS_ENABLED=false
GROUP_ANALYTICS_WEB_ENABLED=false
