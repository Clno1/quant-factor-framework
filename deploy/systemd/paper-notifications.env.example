# Install as /etc/quant/paper-notifications.env with mode 0600 and owner root.
# Create a dedicated Discord channel and Incoming Webhook. Never reuse the
# momentum or sector-rotation webhook and never commit the real URL.
PAPER_DISCORD_WEBHOOK_URL=
PAPER_DISCORD_DELIVERY_ENABLED=false
PAPER_NOTIFICATION_STATE_PATH=/home/projects/quant/outputs/paper_notifications/state.sqlite3
PAPER_DASHBOARD_BASE_URL=http://replace_with_server_ip:18823
PAPER_DISCORD_MAX_ATTEMPTS=3
PAPER_DISCORD_BATCH_LIMIT=25
