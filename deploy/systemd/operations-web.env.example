# Install as /etc/quant/operations-web.env with mode 0600 and root ownership.
# This file is intentionally separate from /etc/quant/web.env.
# SG production binds to 0.0.0.0:18825 and refuses to start without credentials.
# Direct-IP HTTP is not encrypted; prefer an HTTPS reverse proxy for long-term use.
QUANT_OPS_AUTH_USER=quant-ops
QUANT_OPS_AUTH_PASSWORD=replace-with-at-least-16-random-characters

# Optional compatibility override. Values below 8 are rejected.
# QUANT_OPS_AUTH_MIN_PASSWORD_LENGTH=8

# Product decision: the operations monitor does not send Discord alerts.
# Do not put Discord webhook secrets in this environment file.
