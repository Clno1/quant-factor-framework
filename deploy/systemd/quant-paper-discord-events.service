[Unit]
Description=Deliver idempotent paper-trading fill events to Discord
After=network-online.target quant-paper-trading.service
Wants=network-online.target

[Service]
Type=oneshot
User=quant
Group=quant
WorkingDirectory=/opt/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/quant
EnvironmentFile=/etc/quant/paper-notifications.env
ExecStartPre=/opt/quant/.venv/bin/python /opt/quant/scripts/run_paper_notifications.py --check-config
ExecStart=/opt/quant/.venv/bin/python /opt/quant/scripts/run_paper_notifications.py --events
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/quant/outputs /opt/quant/logs
MemoryHigh=160M
MemoryMax=220M

[Install]
WantedBy=multi-user.target
