[Unit]
Description=Build isolated SP500 EOD group analytics artifacts
Wants=network-online.target
After=network-online.target quant-market-data.service
StartLimitIntervalSec=4h
StartLimitBurst=12

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
EnvironmentFile=-/etc/quant/momentum-alerts.env
Environment=GROUP_ANALYTICS_ENABLED=true
Environment=GROUP_ANALYTICS_WEB_ENABLED=false
ExecStartPre=/home/projects/quant/.venv/bin/python -c "import sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStart=/home/projects/quant/.venv/bin/python /home/projects/quant/scripts/run_group_analytics.py --mode eod --universe SP500 --taxonomy FMP --level all --asof latest
TimeoutStartSec=3h
Restart=on-failure
RestartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/data /home/projects/quant/outputs /home/projects/quant/logs
ReadWritePaths=-/home/projects/quant/runlog

[Install]
WantedBy=multi-user.target
