[Unit]
Description=Retry rotation candidate linkage before the premarket digest, independently of payload prepare (root deployment)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=40min
StartLimitBurst=2

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
EnvironmentFile=-/etc/quant/momentum-alerts.env
Environment=GROUP_ANALYTICS_ENABLED=true
Environment=GROUP_ANALYTICS_WEB_ENABLED=false
ExecStartPre=/home/projects/quant/.venv/bin/python -c "import sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStart=/usr/bin/flock --exclusive --wait 60 /home/projects/quant/data/lake/.broad-production.lock /home/projects/quant/.venv/bin/python /home/projects/quant/scripts/run_group_rotation.py --stage linkage --asof latest
TimeoutStartSec=15min
Restart=on-failure
RestartSec=10min
MemoryHigh=400M
MemoryMax=550M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
OOMPolicy=stop
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/data /home/projects/quant/outputs /home/projects/quant/logs
ReadWritePaths=-/home/projects/quant/runlog

[Install]
WantedBy=multi-user.target
