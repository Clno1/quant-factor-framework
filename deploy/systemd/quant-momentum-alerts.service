[Unit]
Description=Quant hourly US momentum alerts
Wants=network-online.target
After=network-online.target quant-us-equity-coverage.service

[Service]
Type=oneshot
User=quant
Group=quant
WorkingDirectory=/opt/quant
EnvironmentFile=/etc/quant/momentum-alerts.env
Environment=PYTHONUNBUFFERED=1
Environment=MPLCONFIGDIR=/opt/quant/data/cache/matplotlib
ExecStartPre=/opt/quant/.venv/bin/python /opt/quant/scripts/verify_momentum_discord_routing.py --component hourly
ExecStart=/opt/quant/.venv/bin/python /opt/quant/scripts/run_momentum_alerts.py --env-file /etc/quant/momentum-alerts.env --send --scheduled-hourly
TimeoutStartSec=50min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
