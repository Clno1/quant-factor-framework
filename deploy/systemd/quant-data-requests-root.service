[Unit]
Description=Process queued custom-universe market-data requests (root deployment)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=1h
# The timer starts this oneshot about 12 times per hour.  Successful starts
# also count toward systemd's rate limit, so keep headroom for retries.
StartLimitBurst=24

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
EnvironmentFile=/etc/quant/market-data.env
ExecStartPre=/home/projects/quant/.venv-worker/bin/python -c "import duckdb, exchange_calendars, sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStart=/home/projects/quant/.venv-worker/bin/python /home/projects/quant/scripts/run_data_requests.py --limit 10 --env-file /etc/quant/market-data.env
TimeoutStartSec=2h
Restart=on-failure
RestartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/data /home/projects/quant/outputs /home/projects/quant/logs
ReadWritePaths=-/home/projects/quant/runlog

[Install]
WantedBy=multi-user.target
