# Install as /etc/quant/intraday-momentum-monitor.env with mode 0600.
FMP_API_KEY=replace_with_your_fmp_key

# Controls whether the worker may start. This lets production opt in without
# replacing the whole YAML configuration file.
INTRADAY_MOMENTUM_MONITOR_ENABLED=true

# With the systemd --auto mode, true still runs shadow until five consecutive
# accepted sessions exist. False is an unconditional delivery kill switch.
INTRADAY_MOMENTUM_DISCORD_ENABLED=false
INTRADAY_MOMENTUM_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me
INTRADAY_MOMENTUM_DISCORD_ROLE_ID=
MOMENTUM_DASHBOARD_BASE_URL=
