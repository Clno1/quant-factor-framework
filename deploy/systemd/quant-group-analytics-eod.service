[Unit]
Description=Build isolated daily sector/theme rotation and candidate snapshots
Wants=network-online.target
After=network-online.target quant-us-daily-refresh.service
StartLimitIntervalSec=4h
StartLimitBurst=12

[Service]
Type=oneshot
User=quant
Group=quant
WorkingDirectory=/opt/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/quant
EnvironmentFile=-/etc/quant/momentum-alerts.env
Environment=GROUP_ANALYTICS_ENABLED=true
Environment=GROUP_ANALYTICS_WEB_ENABLED=false
ExecStartPre=/opt/quant/.venv/bin/python -c "import sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStart=/opt/quant/.venv/bin/python /opt/quant/scripts/run_group_rotation.py --refresh --asof latest
TimeoutStartSec=3h
Restart=on-failure
RestartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
