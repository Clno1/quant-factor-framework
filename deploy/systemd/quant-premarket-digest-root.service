[Unit]
Description=Send isolated US premarket momentum and sector digests
Wants=network-online.target
After=network-online.target quant-us-equity-coverage.service
StartLimitIntervalSec=30min
StartLimitBurst=4

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
Environment=MPLCONFIGDIR=/home/projects/quant/data/cache/matplotlib
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
Environment=VECLIB_MAXIMUM_THREADS=1
Environment=BLIS_NUM_THREADS=1
Environment=PREMARKET_SECTOR_ROTATION_ENABLED=true
EnvironmentFile=/etc/quant/premarket-digest.env
ExecStartPre=/home/projects/quant/.venv/bin/python -c "import sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStartPre=/home/projects/quant/.venv/bin/python /home/projects/quant/scripts/verify_momentum_discord_routing.py --component premarket
ExecStart=/home/projects/quant/.venv/bin/python /home/projects/quant/scripts/run_premarket_digest.py --env-file /etc/quant/premarket-digest.env --send --scheduled --channel all
TimeoutStartSec=10min
Restart=on-failure
RestartSec=3min
RestartPreventExitStatus=2 3
UMask=0077
MemoryHigh=300M
MemoryMax=450M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/data /home/projects/quant/outputs /home/projects/quant/logs
ReadWritePaths=-/home/projects/quant/runlog

[Install]
WantedBy=multi-user.target
