# Install as /etc/quant/web.env with mode 0640.
# Use HTTPS, a private VPN, or an SSH tunnel; Basic Auth alone does not encrypt.
QUANT_WEB_AUTH_USER=quant
QUANT_WEB_AUTH_PASSWORD=replace-with-at-least-16-random-characters
# Optional explicit compatibility override. Values below 8 are rejected.
# QUANT_WEB_AUTH_MIN_PASSWORD_LENGTH=8
