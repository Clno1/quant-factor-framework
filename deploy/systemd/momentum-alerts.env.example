# Install as /etc/quant/momentum-alerts.env with mode 0640 and owner root:quant.
FMP_API_KEY=replace_with_your_fmp_key
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace_me

# Optional: mention one Discord role for new READY/BREAKOUT signals.
DISCORD_ALERT_ROLE_ID=

# Optional: public or private URL of the dashboard for links in Discord messages.
MOMENTUM_DASHBOARD_BASE_URL=

# Optional: comma-separated stocks that should always be evaluated.
MOMENTUM_ALERT_EXTRA_TICKERS=AEVA,OKTA,PENG

