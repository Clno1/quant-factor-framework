[Unit]
Description=Publish version-bound US_LIQUID_5M factor data (root deployment)
After=quant-us-equity-coverage.service
OnSuccess=quant-broad-research-readiness.service
StartLimitIntervalSec=12h
StartLimitBurst=2

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=MALLOC_ARENA_MAX=2
ExecStartPre=/home/projects/quant/.venv/bin/python -c "import duckdb, exchange_calendars, sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStartPre=/home/projects/quant/.venv/bin/python /home/projects/quant/scripts/check_broad_resources.py --minimum-memory-mb 350 --minimum-disk-gb 15
ExecStart=/usr/bin/flock --exclusive --wait 60 /home/projects/quant/data/lake/.broad-production.lock /home/projects/quant/.venv/bin/python /home/projects/quant/scripts/run_broad_factor_data.py --auto-resume --restart-after-partitions 1 --publish --json
TimeoutStartSec=10h
Restart=on-failure
RestartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUAccounting=true
MemoryAccounting=true
TasksAccounting=true
MemoryHigh=700M
MemoryMax=900M
TasksMax=64
OOMPolicy=stop
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/data /home/projects/quant/outputs /home/projects/quant/logs
ReadWritePaths=-/home/projects/quant/runlog

[Install]
WantedBy=multi-user.target
