# Install as /etc/quant/premarket-digest.env with mode 0640 and owner root:quant.
# Keep these two Incoming Webhooks independent and never commit real values.
PREMARKET_DIGEST_ENABLED=false
PREMARKET_SECTOR_ROTATION_ENABLED=true
DISCORD_MOMENTUM_WEBHOOK_URL=
DISCORD_SECTOR_ROTATION_WEBHOOK_URL=

# Optional role pings. Momentum pings only for READY/BREAKOUT; sector pings daily.
DISCORD_MOMENTUM_ROLE_ID=
DISCORD_SECTOR_ROTATION_ROLE_ID=

# Optional dashboard links. Put liquidity bypasses in
# configs/default.yaml -> momentum_alerts.always_tickers so refresh and digest agree.
MOMENTUM_DASHBOARD_BASE_URL=
