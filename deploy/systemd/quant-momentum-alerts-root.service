[Unit]
Description=Quant hourly US momentum alerts
Wants=network-online.target
After=network-online.target quant-us-equity-coverage.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/projects/quant
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/home/projects/quant
Environment=MPLCONFIGDIR=/home/projects/quant/data/cache/matplotlib
EnvironmentFile=/etc/quant/momentum-alerts.env
ExecStartPre=/home/projects/quant/.venv/bin/python -c "import exchange_calendars, sys; assert sys.version_info >= (3, 11), 'Python 3.11+ required'"
ExecStartPre=/home/projects/quant/.venv/bin/python /home/projects/quant/scripts/verify_momentum_discord_routing.py --component hourly
ExecStart=/home/projects/quant/.venv/bin/python /home/projects/quant/scripts/run_momentum_alerts.py --env-file /etc/quant/momentum-alerts.env --send --scheduled-hourly
TimeoutStartSec=50min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/projects/quant/data /home/projects/quant/outputs /home/projects/quant/logs
ReadWritePaths=-/home/projects/quant/runlog
