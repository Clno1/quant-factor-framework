# Illustrative only. CLI never loads this file automatically.
# No provider/model has been selected, no paid run is enabled.
EP_LLM_ENABLED=false
EP_LLM_PROVIDER=openai
EP_LLM_MODEL=
EP_LLM_API_KEY=
# For Kimi set provider=kimi-cn or kimi-intl, model=kimi-k2.6.
# No automatic provider fallback. Kimi never uses EP_LLM_API_KEY.
EP_KIMI_API_KEY=
EP_LLM_DAILY_MICROUSD=3000000
EP_LLM_MONTHLY_MICROUSD=50000000
EP_LLM_TOTAL_MICROUSD=10000000
EP_LLM_MAX_OUTPUT_TOKENS=4000
